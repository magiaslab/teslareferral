---
import ArticleMeta from '../components/ArticleMeta.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Callout from '../components/Callout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Faq from '../components/Faq.astro';
import faq from '../content/faq.json';
import { ROUTES } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { faqPageJsonLd } from '../lib/schema';
import type { FaqItem } from '../types';

const title = 'FAQ referral Tesla: codice, costi e pronta consegna';
const description =
  'Quanto costa il referral Tesla, su quali modelli vale, come si usa in pronta consegna e quando scadono i crediti Supercharger.';
---

<BaseLayout title={title} description={description} jsonLd={faqPageJsonLd()}>
  <article class="section-pad">
    <div class="wrap max-w-[76ch]">
      <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: 'FAQ', path: ROUTES.faq }]} />
      <div class="mt-4">
        <ArticleMeta reading="FAQ" />
      </div>
      <h1 class="display-40 m-0 mt-4">Domande sul referral Tesla</h1>

      <div class="mt-8">
        <Callout title="Da sapere">
          <p class="m-0">
            Il referral Tesla è il programma Segnala e guadagna. Su Model 3 e Model Y
            nuove aggiunge circa 1.000 km Supercharger, allo stesso listino, se usi il
            link prima dell'ordine. Questo sito è indipendente.
          </p>
        </Callout>
      </div>

      <h2 class="heading-28 m-0 mt-12">Le domande che arrivano più spesso</h2>
      <div class="mt-6">
        <Faq items={faq as FaqItem[]} />
      </div>

      <p class="body-16 m-0 mt-12">
        Approfondimenti:{' '}
        <a href={ROUTES.guide} class="text-brand">come funziona</a>
        {' · '}
        <a href={ROUTES.modelY} class="text-brand">Model Y</a>
        {' · '}
        <a href={ROUTES.model3} class="text-brand">Model 3</a>
        {' · '}
        <a href={ROUTES.charging} class="text-brand">ricarica LFP/NMC</a>
        {' · '}
        <a href={ROUTES.delivery} class="text-brand">Tesla pronta consegna</a>
        {' · '}
        <a href={ROUTES.prices} class="text-brand">prezzi e incentivi</a>.
      </p>

      <div class="mt-16">
        <CtaBanner />
      </div>
    </div>
  </article>
</BaseLayout>
