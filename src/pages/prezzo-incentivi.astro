---
import ArticleMeta from '../components/ArticleMeta.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Callout from '../components/Callout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Faq from '../components/Faq.astro';
import KeyPoints from '../components/KeyPoints.astro';
import ReferralCta from '../components/ReferralCta.astro';
import prices from '../content/prices.json';
import { formatVerifiedDateIt, REFERRAL_CTA, ROUTES, SITE_URL, VERIFIED_DATE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { articlePageJsonLd } from '../lib/schema';
import type { FaqItem, PriceRow } from '../types';

const verified = formatVerifiedDateIt();
const rows = prices.rows as PriceRow[];
const model3Rows = rows.filter((row) => row.model === 'Model 3').sort((a, b) => a.listinoEur - b.listinoEur);
const modelYRows = rows.filter((row) => row.model === 'Model Y').sort((a, b) => a.listinoEur - b.listinoEur);
const model3From = model3Rows[0];
const modelYFrom = modelYRows[0];
if (!model3From || !modelYFrom) {
  throw new Error('Listino Model 3/Model Y mancante in prices.json');
}

/** Riferimento bando PNRR MASE 2025–2026 (validazioni fino al 30 giugno 2026). Verificare plafond. */
const incentiveIsee30 = 11000;
const incentiveIsee40 = 9000;

function formatEur(value: number): string {
  return new Intl.NumberFormat('it-IT', {
    style: 'currency',
    currency: 'EUR',
    maximumFractionDigits: 0,
  }).format(value);
}

const model3AfterMaxIncentive = model3From.listinoEur - incentiveIsee30;

const title = 'Prezzi Tesla 2026 con incentivi: quanto costano davvero Model 3 e Model Y';
const description = `Prezzi Tesla 2026 aggiornati: Model 3 da ${formatEur(model3From.listinoEur)} e Model Y da ${formatEur(modelYFrom.listinoEur)}, cosa cambia con gli incentivi e come sommare Ecobonus e 1.000 km Supercharger del referral. Tabella per versione.`;
const h1 = 'Prezzi Tesla 2026 con incentivi: Model 3 e Model Y';

const pageFaq: FaqItem[] = [
  {
    q: 'Quanto costa la Tesla Model 3 con gli incentivi nel 2026?',
    a: `Il listino Model 3 parte da ${formatEur(model3From.listinoEur)} (${model3From.version}, verificato a ${verified}). L'incentivo pubblico, se ne hai diritto e il bando è aperto, è fino a ${formatEur(incentiveIsee30)} (ISEE ≤ 30.000 €) o ${formatEur(incentiveIsee40)} (ISEE 30–40.000 €). Il referral non entra in quel calcolo: aggiunge 1.000 km Supercharger allo stesso listino.`,
  },
  {
    q: 'Quanto costa la Model Y nel 2026?',
    a: `Il listino Model Y parte da ${formatEur(modelYFrom.listinoEur)} (${modelYFrom.version}, verificato a ${verified}). Long Range e Performance salgono. Incentivi statali e referral Tesla sono due canali distinti e cumulabili. Controlla tesla.com.`,
  },
  {
    q: 'Il referral vale anche con gli incentivi?',
    a: 'Sì. Ecobonus (o misura vigente) e referral Tesla non si escludono. L\'incentivo pubblico segue le regole dello Stato; il referral è un extra Tesla: stesso listino, 1.000 km Supercharger, codice prima dell\'ordine.',
  },
];

const jsonLd = articlePageJsonLd({
  path: ROUTES.prices,
  crumbName: 'Prezzi e incentivi',
  headline: h1,
  description,
  about: 'Prezzi Tesla 2026 incentivi Model 3 Model Y',
  faqItems: pageFaq,
  itemList: {
    name: 'Listino Tesla Italia (indicativo)',
    items: rows.map((row) => ({
      name: `Tesla ${row.model} ${row.version}`,
      description: `${formatEur(row.listinoEur)}. ${row.note}.`,
      url: row.model === 'Model Y' ? `${SITE_URL}${ROUTES.modelY}` : `${SITE_URL}${ROUTES.model3}`,
    })),
  },
});
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <article class="section-pad">
    <div class="wrap max-w-[76ch]">
      <Breadcrumb
        items={[{ name: 'Home', path: '/' }, { name: 'Prezzi e incentivi', path: ROUTES.prices }]}
      />
      <div class="mt-4">
        <ArticleMeta reading="Guida · Lettura 8 min" />
      </div>
      <h1 class="display-40 m-0 mt-4">{h1}</h1>
      <p class="body-18 m-0 mt-6">
        I prezzi Tesla 2026 in Italia sono il listino del configuratore: Model 3 da{' '}
        {formatEur(model3From.listinoEur)} e Model Y da {formatEur(modelYFrom.listinoEur)}{' '}
        (verificato a {verified}). Gli incentivi pubblici, se spettano, sono un conto a
        parte. Il referral non sconta l'auto: paghi lo stesso listino e ricevi 1.000 km
        Supercharger se applichi il codice prima di ordinare.
      </p>

      <div class="mt-8">
        <Callout title="Come sommare incentivi e referral">
          <p class="m-0">{REFERRAL_CTA} L'Ecobonus, se ne hai diritto, si calcola sul bando pubblico: i due canali non si escludono.</p>
        </Callout>
      </div>

      <div class="mt-8">
        <KeyPoints
          items={[
            `Listino Model 3 da ${formatEur(model3From.listinoEur)}, Model Y da ${formatEur(modelYFrom.listinoEur)} (verificato a ${verified}).`,
            `Gli incentivi statali, se il bando è aperto: fino a ${formatEur(incentiveIsee30)} (ISEE ≤ 30.000 €) o ${formatEur(incentiveIsee40)} (ISEE 30–40.000 €).`,
            'Il referral non è uno sconto: è 1.000 km Supercharger.',
            'Usa il codice prima dell\'ordine, anche in pronta consegna.',
          ]}
        />
      </div>

      <div class="mt-10">
        <ReferralCta ctaPosition="mid" />
      </div>

      <section class="mt-16">
        <h2 class="heading-28 m-0">Tesla Model 3: prezzo con incentivi 2026</h2>
        <p class="body-18 m-0 mt-4">
          Il <strong>Tesla Model 3 prezzo con incentivi 2026</strong> parte dal listino
          della versione d'ingresso ({model3From.version}: {formatEur(model3From.listinoEur)})
          e scende dell'importo pubblico se rientri nel bando. Esempio: listino{' '}
          {formatEur(model3From.listinoEur)} − {formatEur(incentiveIsee30)} ={' '}
          {formatEur(model3AfterMaxIncentive)} se hai ISEE ≤ 30.000 €, FUA, rottamazione
          e plafond disponibile. Il referral non entra in questa sottrazione. Autonomia e
          Highland: <a href={ROUTES.model3} class="text-brand">guida Model 3</a> · novità:{' '}
          <a href={ROUTES.model3_2026} class="text-brand">Model 3 2026</a>.
        </p>
      </section>

      <section class="mt-16">
        <h2 class="heading-28 m-0">Tesla Model Y: prezzo 2026</h2>
        <p class="body-18 m-0 mt-4">
          Il <strong>Tesla Model Y prezzo 2026</strong> parte da {formatEur(modelYFrom.listinoEur)}{' '}
          ({modelYFrom.version}) e sale su Long Range e Performance. Standard vs le versioni
          superiori:{' '}
          <a href={ROUTES.modelYStandard} class="text-brand">Model Y Standard</a>. SUV,
          autonomia e 7 posti: <a href={ROUTES.modelY} class="text-brand">guida Model Y</a>.
        </p>
      </section>

      <section class="mt-16">
        <h2 class="heading-28 m-0">Quanto costa una Tesla nel 2026?</h2>
        <p class="body-18 m-0 mt-4">
          Il <strong>Tesla prezzo</strong> e il <strong>costo Tesla 2026</strong> in Italia
          sono il listino Model 3 o Model Y sul configuratore, più optional, meno eventuale
          incentivo pubblico. Non esiste un prezzo unico «Tesla». Tabella sotto: verificato a{' '}
          {verified} ({VERIFIED_DATE}), soggetto a variazioni Tesla.
        </p>
        <p class="body-16 text-ink-soft m-0 mt-4">{prices.note}</p>
        <div class="mt-8 overflow-hidden rounded-[14px] border border-line">
          <table class="w-full border-collapse text-left">
            <caption class="sr-only">Listino indicativo Tesla Italia per modello e versione</caption>
            <thead class="bg-[#F3F3F0] dark:bg-[#252830]">
              <tr>
                <th scope="col" class="body-16 font-semibold px-6 py-4 border-b border-line">Modello</th>
                <th scope="col" class="body-16 font-semibold px-6 py-4 border-b border-line">Versione</th>
                <th scope="col" class="body-16 font-semibold px-6 py-4 border-b border-line">Listino</th>
              </tr>
            </thead>
            <tbody>
              {
                rows.map((row, index) => (
                  <tr class={index % 2 === 0 ? 'bg-[#FAFAF8] dark:bg-paper' : 'bg-surface'}>
                    <th scope="row" class="body-16 font-semibold px-6 py-4 border-b border-line">
                      {row.model}
                    </th>
                    <td class="body-16 px-6 py-4 border-b border-line">{row.version}</td>
                    <td class="body-16 px-6 py-4 border-b border-line">{formatEur(row.listinoEur)}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="caption-14 text-ink-soft m-0 mt-4">
          Verificato a {verified}. Importo che conta: configuratore tesla.com. Stock:{' '}
          <a href={ROUTES.delivery} class="text-brand">Tesla pronta consegna</a>.
        </p>
      </section>

      <section class="mt-16">
        <h2 class="heading-28 m-0">Incentivi Tesla 2026: cosa è attivo e cosa no</h2>
        <p class="body-18 m-0 mt-4">
          Gli <strong>incentivi Tesla 2026</strong> non li decide Tesla: sono bandi pubblici
          (PNRR MASE / misura equivalente). Il riferimento 2025–2026 era fino a{' '}
          {formatEur(incentiveIsee30)} con ISEE ≤ 30.000 €, o {formatEur(incentiveIsee40)} con
          ISEE 30–40.000 €, per BEV nuove sotto tetto di listino, residenza in FUA e
          rottamazione fino a Euro 5. Le validazioni del bando PNRR erano ammesse fino al
          30 giugno 2026: a settembre 2026 i fondi risultano in gran parte prenotati.
          Verifica il plafond su{' '}
          <a href="https://www.bonusveicolielettrici.mase.gov.it/" class="text-brand"
            >bonusveicolielettrici.mase.gov.it</a
          >.
        </p>
      </section>

      <section class="mt-16">
        <h2 class="heading-28 m-0">Incentivi + referral: si sommano?</h2>
        <p class="body-18 m-0 mt-4">
          Sì: sono indipendenti. L'incentivo pubblico, se ne hai diritto, riduce quanto
          versi secondo il bando. Il referral Tesla non tocca quel calcolo.{' '}
          {REFERRAL_CTA} Procedura:{' '}
          <a href={ROUTES.guide} class="text-brand">come funziona il referral Tesla</a>.
        </p>
      </section>

      <section class="mt-16">
        <h2 class="heading-28 m-0">Domande su prezzi e incentivi</h2>
        <div class="mt-6">
          <Faq items={pageFaq} />
        </div>
      </section>

      <div class="mt-16">
        <CtaBanner title="Stesso prezzo, in più 1.000 km Supercharger" ctaPosition="footer" />
      </div>
    </div>
  </article>
</BaseLayout>
