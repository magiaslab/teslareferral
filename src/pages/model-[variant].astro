---
import ModelPage from '../components/ModelPage.astro';
import models from '../content/models.json';
import type { Model } from '../types';

export function getStaticPaths() {
  return (models as Model[]).map((model) => ({
    params: { variant: model.variant },
    props: { model },
  }));
}

interface Props {
  model: Model;
}

const { model } = Astro.props;
---

<ModelPage model={model} />
