---
import ArticleMeta from '../components/ArticleMeta.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Callout from '../components/Callout.astro';
import CityBlock from '../components/CityBlock.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Faq from '../components/Faq.astro';
import KeyPoints from '../components/KeyPoints.astro';
import ReferralCta from '../components/ReferralCta.astro';
import { formatVerifiedDateIt, REFERRAL_CTA, ROUTES } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { articlePageJsonLd } from '../lib/schema';
import type { FaqItem } from '../types';
import { getCollection } from 'astro:content';

const cities = (await getCollection('cities')).sort((a, b) => a.data.order - b.data.order);
const verified = formatVerifiedDateIt();
const title = `Tesla pronta consegna Italia (${verified}): come averla subito, città e modelli`;
const description =
  'Tesla in pronta consegna in Italia: come funziona, dove si ritira (Milano, Roma, Bologna, Padova, Torino), differenze tra Model 3 e Model Y disponibili e perché a fine trimestre ce ne sono di più. Stesso prezzo + 1.000 km Supercharger con il referral.';
const h1 = 'Tesla pronta consegna in Italia: come averla subito';

const pageFaq: FaqItem[] = [
  {
    q: 'Cosa significa Tesla pronta consegna?',
    a: 'È un veicolo già prodotto, con configurazione fissa, visibile come stock sul sito Tesla. In Italia può arrivare in 1–2 settimane. Non è un listino diverso: paghi il veicolo scelto. Il codice referral va applicato prima di confermare, anche sullo stock.',
  },
  {
    q: 'Tesla pronta consegna Milano: dove si ritira?',
    a: 'A Milano si ritira nel Delivery Center che Tesla assegna dopo l\'ordine, non in un concessionario. Lo stock si sceglie online; il Delivery team indica sede e slot. Indirizzo esatto: da verificare in app. Dettaglio Store: /store-tesla-italia.',
  },
  {
    q: 'Posso usare il referral su una Tesla in pronta consegna?',
    a: 'Sì. Il link va applicato prima di confermare l\'ordine, anche sullo stock. Dopo l\'invio Tesla non lo associa più. Stesso prezzo di listino, in più 1.000 km Supercharger.',
  },
  {
    q: 'Conviene aspettare la fine del trimestre?',
    a: 'A marzo, giugno, settembre e dicembre di solito c\'è più stock e più slot di delivery. Non è una regola di listino: se ti serve una configurazione rara, l\'attesa può slittare comunque. Confronta pronta consegna e ordine configurato su /tempi-di-consegna.',
  },
];

const jsonLd = articlePageJsonLd({
  path: ROUTES.delivery,
  crumbName: 'Pronta consegna',
  headline: h1,
  description,
  about: 'Tesla pronta consegna Italia',
  faqItems: pageFaq,
});
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} prefetch={[ROUTES.deliveryTimes, ROUTES.guide]}>
  <article class="section-pad">
    <div class="wrap max-w-[76ch]">
      <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: 'Pronta consegna', path: ROUTES.delivery }]} />
      <div class="mt-4">
        <ArticleMeta reading="Guida · Lettura 9 min" />
      </div>
      <h1 class="display-40 m-0 mt-4">{h1}</h1>
      <p class="body-18 m-0 mt-6">
        Una Tesla pronta consegna (o Tesla in pronta consegna) è già in stock: in Italia
        può arrivare in 1–2 settimane, con colore e allestimento fissi. Si ritira dove
        Tesla assegna il Delivery Center (Milano, Roma, Bologna, Padova, Torino). Il
        listino non cambia; i 1.000 km Supercharger arrivano se applichi il codice
        referral prima di ordinare.
      </p>

      <div class="mt-8">
        <Callout title="Da sapere">
          <p class="m-0">{REFERRAL_CTA}</p>
        </Callout>
      </div>

      <div class="mt-8">
        <KeyPoints
          items={[
            'Stock: di solito 1–2 settimane, configurazione già decisa.',
            'Ritiro in Delivery Center Tesla, non da un concessionario.',
            'A fine trimestre di solito c\'è più inventario visibile.',
            'Referral prima dell\'ordine, anche sullo stock.',
          ]}
        />
      </div>

      <div class="mt-10">
        <ReferralCta ctaPosition="mid" />
      </div>

      <section class="mt-16">
        <h2 class="heading-28 m-0">Cosa significa "Tesla pronta consegna"?</h2>
        <p class="body-18 m-0 mt-4">
          Una <strong>Tesla pronta consegna</strong> è un veicolo già prodotto, visibile
          come inventario sul sito Tesla, con colore, ruote e allestimento fissi. Si
          guadagna tempo (spesso 1–2 settimane), si perde la libertà di ogni opzione.
          Non è un listino diverso: il prezzo è quello del veicolo scelto. Il{' '}
          <a href={ROUTES.guide} class="text-brand">codice referral</a> va applicato prima
          di confermare l'ordine, anche sullo stock. Se invece configuri da zero, i tempi
          sono sulla pagina{' '}
          <a href={ROUTES.deliveryTimes} class="text-brand">tempi di consegna Tesla</a>.
        </p>
      </section>

      {cities.map((city) => <CityBlock entry={city} />)}

      <p class="body-16 m-0 mt-8">
        Store, test drive e indirizzi (segnaposto da verificare):{' '}
        <a href={ROUTES.stores} class="text-brand">Store e Delivery Center Tesla in Italia</a>.
      </p>

      <section class="mt-16">
        <h2 class="heading-28 m-0">Model Y in pronta consegna</h2>
        <p class="body-18 m-0 mt-4">
          La <strong>Tesla Model Y pronta consegna</strong> è lo stock SUV che si vede più
          spesso in Italia: ritiro rapido se accetti versione e colore già prodotti.
          Controlla RWD/Standard, Long Range o Performance e la chimica della batteria
          nella <a href={ROUTES.charging} class="text-brand">guida alla ricarica</a>.
          Autonomia e Standard:{' '}
          <a href={ROUTES.modelY} class="text-brand">guida Model Y</a> e{' '}
          <a href={ROUTES.modelYStandard} class="text-brand">Model Y Standard</a>. Il
          referral resta 1.000 km Supercharger se il link era applicato prima dell'ordine.
        </p>
      </section>

      <section class="mt-16">
        <h2 class="heading-28 m-0">Model 3 in pronta consegna</h2>
        <p class="body-18 m-0 mt-4">
          Una <strong>Tesla Model 3 pronta consegna</strong> segue la stessa logica: stock
          fisso, ritiro in 1–2 settimane se c'è disponibilità. Vale sulla Highland e sulle
          versioni che Tesla pubblica come inventario. Il referral non sconta il listino:
          è un extra di ricarica. Dettaglio su autonomia e prezzo:{' '}
          <a href={ROUTES.model3} class="text-brand">Model 3</a>,{' '}
          <a href={ROUTES.model3_2026} class="text-brand">Model 3 2026</a> e{' '}
          <a href={ROUTES.prices} class="text-brand">prezzi e incentivi</a>.
        </p>
      </section>

      <section class="mt-16">
        <h2 class="heading-28 m-0">Perché a fine trimestre ci sono più Tesla in pronta consegna</h2>
        <p class="body-18 m-0 mt-4">
          Tesla rendiconta le consegne per trimestre fiscale. A marzo, giugno, settembre e
          dicembre i volumi salgono: più veicoli in stock, più slot di delivery, a volte
          più <strong>pronta consegna</strong>. Chi ha flessibilità su colore e allestimento
          può accettare uno stock e accorciare l'attesa a 1–2 settimane.
        </p>
        <p class="body-18 m-0 mt-4">
          Il rischio opposto è lo slittamento a inizio trimestre successivo se la
          configurazione è rara. Chi usa l'Ecobonus deve tenere d'occhio i 270 giorni per
          l'immatricolazione. {REFERRAL_CTA}
        </p>
      </section>

      <section class="mt-16">
        <h2 class="heading-28 m-0">Pronta consegna o configurata su misura: cosa conviene?</h2>
        <p class="body-18 m-0 mt-4">
          Conviene lo stock se ti serve l'auto subito e accetti la combinazione già
          prodotta. Conviene configurare se colore, ruote o versione non sono negoziabili:
          l'attesa si allunga e cade spesso a fine trimestre. Confronto tempi per Model 3
          e Model Y:{' '}
          <a href={ROUTES.deliveryTimes} class="text-brand">tempi di consegna Tesla 2026</a>.
          In entrambi i casi il referral va usato <em>prima</em> dell'ordine.
        </p>
      </section>

      <section class="mt-16">
        <h2 class="heading-28 m-0">Domande frequenti sulla pronta consegna</h2>
        <div class="mt-6">
          <Faq items={pageFaq} />
        </div>
      </section>

      <div class="mt-16">
        <CtaBanner
          title="Referral prima dell'ordine, anche in pronta consegna"
          summary={REFERRAL_CTA}
          ctaPosition="footer"
        />
      </div>
    </div>
  </article>
</BaseLayout>
