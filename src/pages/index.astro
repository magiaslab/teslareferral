---
import Breadcrumb from '../components/Breadcrumb.astro';
import Button from '../components/Button.astro';
import Callout from '../components/Callout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Faq from '../components/Faq.astro';
import KeyPoints from '../components/KeyPoints.astro';
import ModelTable from '../components/ModelTable.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import Pill from '../components/Pill.astro';
import Step from '../components/Step.astro';
import faq from '../content/faq.json';
import {
  formatVerifiedDateIt,
  HOW_TO_STEPS,
  CONTACT_EMAIL,
  CONTACT_MAILTO,
  MAGIASLAB_URL,
  OWNER_NAME,
  OWNER_ORG,
  REFERRAL_URL,
  ROUTES,
  VERIFIED_DATE,
} from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeJsonLd } from '../lib/schema';
import type { FaqItem } from '../types';

const verified = formatVerifiedDateIt(VERIFIED_DATE);
const title = 'Referral Tesla Italia: 1.000 km Supercharger con il codice';
const description =
  'In Italia il codice referral Tesla aggiunge circa 1.000 km Supercharger su Model 3 e Model Y nuove, allo stesso prezzo di listino. Va usato prima di ordinare.';
const homeFaq = (faq as FaqItem[]).slice(0, 5);
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={homeJsonLd()}
  prefetch={[ROUTES.guide, ROUTES.delivery, ROUTES.prices]}
>
  <section class="section-pad">
    <div class="wrap grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 items-center">
      <div class="md:col-span-7">
        <Breadcrumb items={[{ name: 'Home', path: '/' }]} />
        <div class="mt-5">
          <Pill variant="brand" icon="badge-check">Ho una Model Y</Pill>
        </div>
        <h1 class="display-56 m-0 mt-5">
          1.000 km Supercharger con il codice referral Tesla
        </h1>
        <p class="body-18 text-ink-soft m-0 mt-6 max-w-[40rem]">
          In Italia il <strong class="text-ink font-semibold">referral Tesla</strong> non sconta
          il listino: paghi lo stesso prezzo e ricevi{' '}
          <span class="num-hl">1.000 km di ricariche gratuite</span>
          {' '}su Model 3 e Model Y, se usi il codice prima di ordinare.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <Button href={REFERRAL_URL} external hero icon="arrow-right">Ottieni i 1.000 km</Button>
          <Button variant="secondary" href={ROUTES.guide} icon="book-open">Come funziona</Button>
        </div>
        <p class="caption-14 text-ink-soft m-0 mt-4">
          <a href={ROUTES.guide} class="text-brand">Come funziona</a>
          {' · '}
          <a href={ROUTES.delivery} class="text-brand">Tesla pronta consegna</a>
          {' · '}
          <a href={ROUTES.prices} class="text-brand">Prezzi e incentivi</a>
          {' · '}
          <a href={ROUTES.modelY} class="text-brand">Model Y</a>
        </p>
      </div>
      <div class="md:col-span-5">
        <PhotoSlot
          src="/img/home-hero"
          aspect="4/3"
          width={800}
          height={600}
          alt="Tesla in ricarica a una stazione Supercharger"
          caption="I 1.000 km Supercharger si usano qui, in viaggio."
          priority
        />
      </div>
    </div>
  </section>

  <section class="pb-16 md:pb-24">
    <div class="wrap grid gap-8">
      <Callout title="Da sapere">
        <p class="m-0">
          Con un codice referral Tesla ricevi circa 1.000 km Supercharger su Model 3 e
          Model Y, allo stesso prezzo di listino. Usalo prima di configurare l'auto:
          dopo l'ordine non si aggiunge. Tesla può cambiare l'offerta
          ({verified}).
        </p>
      </Callout>
      <KeyPoints
        items={[
          'Circa 1.000 km Supercharger su Model 3 e Model Y nuove. Conta quanto vedi sull\'ordine.',
          'Il listino non sale: i chilometri sono un extra.',
          'Vale al primo acquisto, se apri il link prima di confermare.',
          'Model S e Model X restano fuori.',
        ]}
      />
    </div>
  </section>

  <section id="stai-per-comprare" class="section-pad bg-surface">
    <div class="wrap">
      <h2 class="heading-28 m-0">Stai per comprare? Parti da qui</h2>
      <p class="body-18 text-ink-soft m-0 mt-4 max-w-[40rem]">
        Se stai scegliendo l'auto, inizia da tempi di ritiro e listino. Il referral si applica
        dopo, sullo stesso prezzo, prima di confermare l'ordine.
      </p>
      <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
        <a
          href={ROUTES.delivery}
          class="block rounded-[14px] border border-line bg-paper p-7 no-underline text-ink hover:border-brand"
        >
          <p class="caption-14 text-ink-soft m-0">Tempi</p>
          <p class="heading-22 m-0 mt-2">Tesla pronta consegna</p>
          <p class="body-16 text-ink-soft m-0 mt-3">
            Stock in 1–2 settimane, sprint di fine trimestre, Model 3 e Model Y.
          </p>
        </a>
        <a
          href={ROUTES.prices}
          class="block rounded-[14px] border border-line bg-paper p-7 no-underline text-ink hover:border-brand"
        >
          <p class="caption-14 text-ink-soft m-0">Listino</p>
          <p class="heading-22 m-0 mt-2">Prezzi e incentivi</p>
          <p class="body-16 text-ink-soft m-0 mt-3">
            Model 3 e Model Y, Ecobonus cumulabile, 1.000 km Supercharger.
          </p>
        </a>
      </div>
    </div>
  </section>

  <section id="come-funziona" class="section-pad">
    <div class="wrap">
      <h2 class="heading-28 m-0">Come si usa il referral Tesla</h2>
      <p class="body-18 text-ink-soft m-0 mt-4 max-w-[40rem]">
        Dal link all'ordine su Tesla.com bastano pochi minuti. Qui non ti registri.
      </p>
      <ol class="mt-12 grid gap-8 list-none m-0 p-0">
        {
          HOW_TO_STEPS.map((step, index) => (
            <Step n={index + 1} title={step.title}>
              {step.text}
            </Step>
          ))
        }
      </ol>
      <p class="body-16 m-0 mt-8">
        Il passo passo è nella <a href={ROUTES.guide} class="text-brand">guida Segnala e guadagna</a>.
      </p>
    </div>
  </section>

  <section id="vantaggi" class="section-pad cv-auto">
    <div class="wrap">
      <h2 class="heading-28 m-0">Su quali Tesla vale il referral</h2>
      <p class="body-18 text-ink-soft m-0 mt-4">
        Solo Model 3 e Model Y nuove, comprate da Tesla. Il listino resta quello.
      </p>
      <div class="mt-12">
        <ModelTable />
      </div>
    </div>
  </section>

  <section id="pronta-consegna" class="section-pad bg-surface cv-auto">
    <div class="wrap grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-6 items-start">
      <div class="md:col-span-7">
        <h2 class="heading-28 m-0">Tesla pronta consegna in Italia: tempi reali</h2>
        <p class="body-18 text-ink-soft m-0 mt-4">
          Una <strong class="text-ink font-semibold">Tesla in pronta consegna</strong> può
          arrivare in <strong class="text-ink font-semibold">1–2 settimane</strong>. Se la
          configuri da zero, l'attesa si sposta spesso a fine trimestre. Il referral va
          usato prima di confermare, anche sullo stock.
        </p>
        <p class="body-16 m-0 mt-6">
          Tempi e stock: <a href={ROUTES.delivery} class="text-brand">Tesla pronta consegna in Italia</a>.
        </p>
      </div>
      <div class="md:col-span-5">
        <Callout title="Stock vs configurata">
          <p class="m-0">
            Stock: 1–2 settimane, configurazione già decisa. Auto configurata: di solito
            fine trimestre. Stesso referral su{' '}
            <a href={ROUTES.modelY} class="text-brand">Model Y</a> e{' '}
            <a href={ROUTES.model3} class="text-brand">Model 3</a>.
          </p>
        </Callout>
      </div>
    </div>
  </section>

  <section class="section-pad cv-auto">
    <div class="wrap grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-6 items-center">
      <div class="md:col-span-5">
        <PhotoSlot
          src="/img/home-trust"
          aspect="1/1"
          width={800}
          height={800}
          alt="Alessandro Cipriani con la sua Tesla Model Y"
          caption="Alessandro con la sua Model Y."
        />
      </div>
      <div class="md:col-span-7">
        <h2 class="heading-28 m-0">Chi c'è dietro il link referral?</h2>
        <p class="body-18 text-ink-soft m-0 mt-4">
          Guido una Tesla Model Y ogni giorno e conosco la ricarica domestica, i
          Supercharger e la configurazione. Se hai dubbi prima dell'ordine — modello
          giusto, autonomia reale, wallbox, tariffe di ricarica — ti aiuto
          gratuitamente, senza impegno. Nessun call center: scrivi direttamente a me.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <Pill variant="brand" icon="badge-check">Proprietario Tesla</Pill>
          <Pill variant="outline">{OWNER_NAME}</Pill>
        </div>
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <Button variant="secondary" href={CONTACT_MAILTO} icon="mail">
            {CONTACT_EMAIL}
          </Button>
          <Button variant="ghost" href={MAGIASLAB_URL} external icon="globe">
            {OWNER_ORG}
          </Button>
        </div>
        <p class="caption-14 text-ink-soft m-0 mt-8 pt-6 border-t border-line">
          Trasparenza: usando il mio link, tu ricevi il vantaggio e io un piccolo credito
          Tesla. Nessun costo aggiuntivo per te.
        </p>
      </div>
    </div>
  </section>

  <section id="faq" class="section-pad cv-auto">
    <div class="wrap max-w-[840px] mx-auto">
      <h2 class="heading-28 m-0">Domande sul referral Tesla</h2>
      <div class="mt-8">
        <Faq items={homeFaq} />
      </div>
      <p class="body-16 m-0 mt-8">
        Altre risposte (scadenze, Ecobonus, Model S/X) nella <a href={ROUTES.faq} class="text-brand">FAQ completa</a>.
      </p>
    </div>
  </section>

  <section class="pb-16 md:pb-24">
    <div class="wrap">
      <CtaBanner />
    </div>
  </section>
</BaseLayout>
