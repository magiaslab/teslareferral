---
import ArticleMeta from '../components/ArticleMeta.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Button from '../components/Button.astro';
import Callout from '../components/Callout.astro';
import Card from '../components/Card.astro';
import Disclaimer from '../components/Disclaimer.astro';
import Faq from '../components/Faq.astro';
import KeyPoints from '../components/KeyPoints.astro';
import ModelTable from '../components/ModelTable.astro';
import {
  CONTACT_MAILTO,
  HOW_TO_STEPS,
  PROGRAM_EN,
  PROGRAM_IT,
  REFERRAL_URL,
  ROUTES,
} from '../consts';
import faq from '../content/faq.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import { guideJsonLd } from '../lib/schema';
import type { FaqItem } from '../types';

const title = 'Come funziona il referral Tesla in Italia';
const description =
  'Il programma Segnala e guadagna aggiunge circa 1.000 km Supercharger su Model 3 e Model Y. Quando usarlo, quanto vale e perché non è uno sconto.';

const toc = [
  { id: 'che-cose', label: 'Che cos\'è' },
  { id: 'modelli-idonei', label: 'Quali modelli' },
  { id: 'quanto-vale', label: 'Quanto vale' },
  { id: 'come-si-usa', label: 'Come si usa' },
  { id: 'dopo-ordine', label: 'Dopo l\'ordine' },
  { id: 'limiti', label: 'Limiti e scadenze' },
  { id: 'incentivo', label: 'Ecobonus e incentivi' },
  { id: 'faq', label: 'Domande frequenti' },
];

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Come funziona', path: ROUTES.guide },
];
---

<BaseLayout title={title} description={description} jsonLd={guideJsonLd()}>
  <div class="section-pad">
    <div class="wrap">
      <Breadcrumb items={crumbs} />
      <div class="mt-3">
        <ArticleMeta reading="Guida · Lettura 9 min" />
      </div>

      <div class="mt-8 grid grid-cols-1 lg:grid-cols-[220px_minmax(0,1fr)] gap-8 lg:gap-12 items-start">
      <aside>
        <details class="lg:hidden rounded-[14px] border border-line bg-surface p-4">
          <summary class="min-h-11 cursor-pointer font-semibold">
            Indice
          </summary>
          <nav aria-label="Indice della guida" class="mt-3">
            <ol class="list-none m-0 p-0 grid">
              {
                toc.map((item) => (
                  <li>
                    <a href={`#${item.id}`} class="flex items-center min-h-10 caption-14 text-ink no-underline hover:text-brand">
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>
        </details>

        <nav aria-label="Indice della guida" class="hidden lg:block sticky top-24 rounded-[14px] border border-line bg-surface p-5">
          <p class="caption-14 font-semibold m-0 text-ink-soft">Indice</p>
          <ol class="list-none m-0 mt-3 p-0 grid">
            {
              toc.map((item) => (
                <li>
                  <a href={`#${item.id}`} class="flex items-start min-h-9 py-1.5 caption-14 text-ink no-underline hover:text-brand">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </aside>

      <article class="min-w-0 max-w-[68ch]">
        <h1 class="display-40 m-0">Come funziona il referral Tesla</h1>

        <div class="mt-8">
          <Callout title="Da sapere">
            <p class="m-0">
              Il referral Tesla è il programma «{PROGRAM_IT}» ({PROGRAM_EN}). Chi ordina una
              Model 3 o Model Y nuova dal link di un proprietario riceve circa 1.000 km
              Supercharger, senza pagare di più. Chi condivide il link riceve crediti Tesla.
            </p>
          </Callout>
        </div>

        <div class="mt-8">
          <KeyPoints
            items={[
              'Solo Model 3 e Model Y nuove.',
              'Circa 1.000 km Supercharger: conta quanto vedi sull\'ordine.',
              'Apri il link prima di confermare.',
              'Chi condivide il link: fino a 10 acquisti l\'anno.',
              'I crediti durano 12 mesi, allungabili fino a 36.',
              'Si cumula con l\'Ecobonus: non lo sostituisce.',
            ]}
          />
        </div>

        <section id="che-cose" class="mt-16">
          <h2 class="heading-28 m-0">Che cos'è il referral Tesla?</h2>
          <p class="body-18 m-0 mt-4">
            «{PROGRAM_IT}» ({PROGRAM_EN}) è il programma con cui un proprietario Tesla
            condivide un link personale. Chi compra una Model 3 o Model Y nuova da quel
            link riceve i chilometri Supercharger; chi lo condivide riceve crediti Tesla.
            Quei crediti servono per Supercharger, software, assistenza o Tesla Shop: non
            per gli abbonamenti e non si trasformano in contanti.
          </p>
          <p class="body-18 m-0 mt-4">
            CodiceEV non gestisce il programma e non è affiliato a Tesla. Il link apre
            tesla.com con il codice già inserito. Qui non ti registri. L'offerta è privata
            Tesla e si può usare insieme agli incentivi pubblici.
          </p>
        </section>

        <section id="modelli-idonei" class="mt-16">
          <h2 class="heading-28 m-0">Quali modelli Tesla entrano nel referral</h2>
          <p class="body-18 m-0 mt-4">
            Solo <strong>Model 3</strong> e <strong>Model Y</strong> nuove. Model S e Model X
            sono fuori: lo sconto di 500 € che alcuni siti citano ancora non è più in vigore.
            Stesso discorso per l'usato certificato (Tesla Approved) e per le auto di terzi.
          </p>
          <div class="mt-8">
            <ModelTable />
          </div>
          <p class="body-16 m-0 mt-6">
            Dettaglio per modello: <a href={ROUTES.modelY} class="text-brand">vantaggi Model Y</a>
            {' '}e <a href={ROUTES.model3} class="text-brand">vantaggi Model 3</a>.
          </p>
        </section>

        <section id="quanto-vale" class="mt-16">
          <h2 class="heading-28 m-0">Quanto vale il referral Tesla</h2>
          <p class="body-18 m-0 mt-4">
            Per chi compra, oggi sono circa <strong>1.000 km Supercharger</strong>. Quello che
            compare sull'ordine è quello che conta: Tesla può cambiare l'offerta. In pratica
            quei chilometri valgono 60–70 € di ricariche, a seconda di tariffa e percorso.
          </p>
          <p class="body-18 m-0 mt-4">
            I crediti di chi condivide il link si usano per Supercharger, software, assistenza
            o Tesla Shop. Non coprono gli abbonamenti e non diventano soldi.
          </p>
        </section>

        <section id="come-si-usa" class="mt-16">
          <h2 class="heading-28 m-0">Come si usa il codice</h2>
          <p class="body-18 m-0 mt-4">
            Tutto succede su Tesla.com, non su questo sito. I passaggi sono tre.
          </p>
          <ol class="body-18 mt-6 pl-6 grid gap-4">
            {
              HOW_TO_STEPS.map((step, index) => (
                <li>
                  <span class="font-semibold">{index + 1}. {step.title}.</span>{' '}
                  {step.text}
                </li>
              ))
            }
          </ol>
          <p class="body-16 text-ink-soft m-0 mt-6">
            Il codice resta sulla sessione aperta dal link. Se copi l'indirizzo in un altro
            browser, in una finestra anonima o su un altro telefono, può sparire. Configura e
            conferma lì.
          </p>
        </section>

        <section id="dopo-ordine" class="mt-16">
          <h2 class="heading-28 m-0">Si può aggiungere dopo l'ordine?</h2>
          <p class="body-18 m-0 mt-4">
            No. Dopo l'invio Tesla non lo associa più. Un account lo usa una volta sola.
          </p>
        </section>

        <section id="limiti" class="mt-16">
          <h2 class="heading-28 m-0">Quali sono i limiti e le scadenze?</h2>
          <ul class="body-18 mt-6 pl-6 grid gap-3">
            <li>Chi condivide il link: fino a 10 acquisti per anno solare.</li>
            <li>I vantaggi restano in sospeso nell'app fino alla concessione, poi durano 12 mesi.</li>
            <li>Ogni nuovo acquisto dal tuo link può allungare i Supercharger di 12 mesi, fino a 36.</li>
            <li>
              Termini Tesla in vigore dal 3 ottobre 2024, aggiornati il 4 giugno 2025.
            </li>
          </ul>
        </section>

        <section id="incentivo" class="mt-16">
          <h2 class="heading-28 m-0">È un incentivo statale?</h2>
          <p class="body-18 m-0 mt-4">
            No. È un'offerta Tesla, distinta da Ecobonus e bonus regionali. Quelli pubblici
            hanno regole proprie: ISEE, tipo di auto e, di solito, 270 giorni per
            l'immatricolazione. Il referral non le cambia. Per i tempi di ritiro vedi{' '}
            <a href={ROUTES.delivery} class="text-brand">Tesla pronta consegna in Italia</a>.
          </p>
        </section>

        <section id="faq" class="mt-16">
          <h2 class="heading-28 m-0">Domande frequenti</h2>
          <div class="mt-6">
            <Faq items={faq as FaqItem[]} />
          </div>
        </section>

        <Card class="mt-16">
          <h2 class="heading-22 m-0">Vuoi usare il link?</h2>
          <p class="body-16 text-ink-soft m-0 mt-3">
            Si apre Tesla.com con il codice già inserito. Il listino non cambia.
          </p>
          <div class="mt-6 flex flex-col sm:flex-row gap-4">
            <Button href={REFERRAL_URL} external icon="arrow-right">Ottieni i 1.000 km</Button>
            <Button variant="secondary" href={CONTACT_MAILTO} icon="mail">
              Hai dubbi? Scrivimi
            </Button>
          </div>
          <p class="caption-14 m-0 mt-6">
            <a href={ROUTES.modelY} class="text-brand">Vantaggi Model Y</a>
            {' · '}
            <a href={ROUTES.model3} class="text-brand">Vantaggi Model 3</a>
            {' · '}
            <a href={ROUTES.delivery} class="text-brand">Tesla pronta consegna</a>
            {' · '}
            <a href={ROUTES.faq} class="text-brand">FAQ</a>
          </p>
          <div class="mt-6 pt-6 border-t border-line">
            <Disclaimer />
          </div>
        </Card>
      </article>
      </div>
    </div>
  </div>
</BaseLayout>
