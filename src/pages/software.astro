---
import ArticleMeta from '../components/ArticleMeta.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Callout from '../components/Callout.astro';
import Faq from '../components/Faq.astro';
import KeyPoints from '../components/KeyPoints.astro';
import software from '../content/software.json';
import { ROUTES } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { articlePageJsonLd } from '../lib/schema';
import type { FaqItem } from '../types';

const title = 'Grok Tesla e aggiornamenti software';
const description =
  'Cos\'è Grok Tesla, cosa c\'è nel Summer Update 2026.26 (Hey Grok, Preferred Routes, Supercharger Search) e cosa restava dallo Spring Update.';
const h1 = 'Grok Tesla e gli aggiornamenti in auto';

const pageFaq: FaqItem[] = [
  {
    q: 'Che cos\'è Grok Tesla?',
    a: 'Grok Tesla è l\'assistente vocale in auto: nelle release 2026 può gestire chiamate, musica e clima, oltre alle domande in linguaggio naturale. La disponibilità dipende da paese, hardware e Premium Connectivity.',
  },
  {
    q: 'Qual è l\'aggiornamento Tesla più recente?',
    a: `L'ultimo grande update è il ${software.latestName} (versione ${software.latestVersion}). Tesla ne manda due all'anno, più patch in mezzo.`,
  },
  {
    q: 'FSD v14 è in Italia?',
    a: 'FSD v14 compare nelle note globali. In Italia restano le funzioni omologate: guarda cosa mostra l\'auto, non il nome della release americana.',
  },
];

const jsonLd = articlePageJsonLd({
  path: ROUTES.software,
  crumbName: 'Software',
  headline: h1,
  description,
  about: 'Grok Tesla e aggiornamento software 2026',
  faqItems: pageFaq,
});
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <article class="section-pad">
    <div class="wrap max-w-[76ch]">
      <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: 'Software', path: ROUTES.software }]} />
      <div class="mt-4">
        <ArticleMeta reading="Note di rilascio · Lettura 6 min" />
      </div>
      <h1 class="display-40 m-0 mt-4">{h1}</h1>

      <div class="mt-8">
        <Callout title="Da sapere">
          <p class="m-0">
            Grok è l'assistente vocale in auto. L'aggiornamento più recente è il{' '}
            <strong>{software.latestName}</strong> (versione {software.latestVersion}):
            chiamate, musica, clima, itinerari preferiti e ricerca Supercharger. Tesla
            manda due grandi update OTA all'anno.
          </p>
        </Callout>
      </div>

      <div class="mt-8">
        <KeyPoints
          items={[
            'Grok risponde a voce e, dove c\'è, gestisce clima, musica e chiamate.',
            `Ultimo grande update: ${software.latestName} (${software.latestVersion}).`,
            software.cadence,
            'Itinerari e Supercharger Search aiutano i viaggi; i km del referral restano crediti.',
          ]}
        />
      </div>

      <section class="mt-16">
        <h2 class="heading-28 m-0">Che cos'è Grok Tesla?</h2>
        <p class="body-18 m-0 mt-4">
          <strong>Grok Tesla</strong> è l'assistente vocale in auto. Nelle release recenti
          risponde in linguaggio naturale e, dove c'è, gestisce chiamate, musica e clima
          («Hey Grok»). Dipende da paese, hardware e a volte da Premium Connectivity. Non
          è un extra del referral e non tocca i 1.000 km Supercharger.
        </p>
      </section>

      <section class="mt-16">
        <h2 class="heading-28 m-0">Aggiornamento Tesla 2026: Summer Update (2026.26)</h2>
        <p class="body-18 m-0 mt-4">
          Il Summer Update 2026 è il secondo grande OTA dell'anno. Le novità principali, secondo le
          release notes Tesla, sono:
        </p>
        <ul class="body-18 mt-6 pl-6 grid gap-3">
          {software.summer.map((item) => <li>{item}</li>)}
        </ul>
        <p class="body-18 m-0 mt-4">
          Preferred Routes e Automatic Navigation riducono i ritocchi al viaggio. Set Arrival Energy
          e Supercharger Search si legano alla{' '}
          <a href={ROUTES.charging} class="text-brand">strategia di ricarica</a>: arrivare con il
          SoC giusto e precondizionare. I km del{' '}
          <a href={ROUTES.guide} class="text-brand">referral Tesla</a> restano crediti Supercharger,
          indipendenti dal software.
        </p>
      </section>

      <section class="mt-16">
        <h2 class="heading-28 m-0">Cosa c'era già nello Spring Update 2026?</h2>
        <p class="body-18 m-0 mt-4">
          Lo Spring Update ha aperto il ciclo annuale. Tra le voci più citate:
        </p>
        <ul class="body-18 mt-6 pl-6 grid gap-3">
          {software.spring.map((item) => <li>{item}</li>)}
        </ul>
        <p class="body-18 m-0 mt-4">
          Grok, Pet Mode e dashcam 24h dipendono da hardware, paese e (in alcuni casi) Premium
          Connectivity. FSD v14 è una linea delle note globali: in Italia vale ciò che l'auto
          mostra come omologato, non il nome della release americana.
        </p>
      </section>

      <section class="mt-16">
        <h2 class="heading-28 m-0">Ogni quanto Tesla aggiorna il software?</h2>
        <p class="body-18 m-0 mt-4">
          {software.cadence} In mezzo arrivano patch minori. I chilometri del referral e gli
          <a href={ROUTES.delivery} class="text-brand">tempi di consegna</a> non dipendono
          dalla versione software.
        </p>
      </section>

      <section class="mt-16">
        <h2 class="heading-28 m-0">Domande frequenti sul software Tesla</h2>
        <div class="mt-6">
          <Faq items={pageFaq} />
        </div>
      </section>
    </div>
  </article>
</BaseLayout>
