---
import ArticleMeta from '../components/ArticleMeta.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Callout from '../components/Callout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Faq from '../components/Faq.astro';
import KeyPoints from '../components/KeyPoints.astro';
import ReferralCta from '../components/ReferralCta.astro';
import SoftwareNote from '../components/SoftwareNote.astro';
import software from '../content/software.json';
import { REFERRAL_CTA, ROUTES } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { articlePageJsonLd } from '../lib/schema';
import type { FaqItem } from '../types';
import { getCollection } from 'astro:content';

const notes = (await getCollection('softwareNotes')).sort((a, b) => a.data.order - b.data.order);
const title = 'Grok Tesla Italia, FSD e aggiornamenti software 2026';
const description =
  'FSD in Italia nel 2026, Grok Tesla in italiano (attivazione e Model 3 Grok update) e Summer Update. Il software non tocca i 1.000 km Supercharger del referral.';
const h1 = 'Grok Tesla e gli aggiornamenti in auto';

const pageFaq: FaqItem[] = [
  {
    q: 'Grok Tesla Italia: come si attiva?',
    a: 'Aggiorna il software in auto e cerca Grok nel menu vocale. Lingua italiana e funzioni dipendono da paese, hardware, release e spesso Premium Connectivity. Non è un extra del referral.',
  },
  {
    q: 'FSD in Italia: a che punto siamo nel 2026?',
    a: 'Restano le funzioni omologate che l\'auto mostra. Le note US (anche FSD v14) non equivalgono a un\'abilitazione italiana. Guarda il menu Autopilot / FSD del veicolo.',
  },
  {
    q: 'Qual è l\'aggiornamento Tesla più recente?',
    a: `L'ultimo grande update è il ${software.latestName} (versione ${software.latestVersion}). Tesla ne manda due all'anno, più patch in mezzo.`,
  },
];

const jsonLd = articlePageJsonLd({
  path: ROUTES.software,
  crumbName: 'Software',
  headline: h1,
  description,
  about: 'Grok Tesla Italia FSD aggiornamento software 2026',
  faqItems: pageFaq,
});
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <article class="section-pad">
    <div class="wrap max-w-[76ch]">
      <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: 'Software', path: ROUTES.software }]} />
      <div class="mt-4">
        <ArticleMeta reading="Note di rilascio · Lettura 7 min" />
      </div>
      <h1 class="display-40 m-0 mt-4">{h1}</h1>
      <p class="body-18 m-0 mt-6">
        Grok Tesla Italia è l'assistente vocale in auto; FSD in Italia resta ciò che è
        omologato sul veicolo, non il nome della release americana. L'ultimo grande OTA è
        il {software.latestName} ({software.latestVersion}). Il referral non sblocca
        software: stesso listino, 1.000 km Supercharger se il codice è applicato prima
        dell'ordine.
      </p>

      <div class="mt-8">
        <Callout title="Da sapere">
          <p class="m-0">{REFERRAL_CTA} Grok e FSD non lo sostituiscono e non lo richiedono.</p>
        </Callout>
      </div>

      <div class="mt-8">
        <KeyPoints
          items={[
            'Grok in italiano dipende da rollout, hardware e spesso Premium Connectivity.',
            'FSD Italia: guarda le funzioni attive in auto, non le note US.',
            `Ultimo grande update: ${software.latestName} (${software.latestVersion}).`,
            'I km del referral restano crediti Supercharger, indipendenti dal software.',
          ]}
        />
      </div>

      <div class="mt-10">
        <ReferralCta ctaPosition="mid" />
      </div>

      {notes.map((note) => <SoftwareNote entry={note} />)}

      <section class="mt-16">
        <h2 class="heading-28 m-0">Aggiornamento Tesla 2026: Summer Update (2026.26)</h2>
        <p class="body-18 m-0 mt-4">
          Il Summer Update 2026 è il secondo grande OTA dell'anno. Le novità principali,
          secondo le release notes Tesla, sono:
        </p>
        <ul class="body-18 mt-6 pl-6 grid gap-3">
          {software.summer.map((item) => <li>{item}</li>)}
        </ul>
        <p class="body-18 m-0 mt-4">
          Un Tesla Model 3 Grok update è questo tipo di OTA, non un allestimento.
          Preferred Routes e Supercharger Search si legano alla{' '}
          <a href={ROUTES.charging} class="text-brand">strategia di ricarica</a>. I km del{' '}
          <a href={ROUTES.guide} class="text-brand">referral Tesla</a> restano crediti.
        </p>
      </section>

      <section class="mt-16">
        <h2 class="heading-28 m-0">Cosa c'era già nello Spring Update 2026?</h2>
        <p class="body-18 m-0 mt-4">Tra le voci più citate:</p>
        <ul class="body-18 mt-6 pl-6 grid gap-3">
          {software.spring.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="mt-16">
        <h2 class="heading-28 m-0">Ogni quanto Tesla aggiorna il software?</h2>
        <p class="body-18 m-0 mt-4">
          {software.cadence} In mezzo arrivano patch minori. I chilometri del referral e i{' '}
          <a href={ROUTES.deliveryTimes} class="text-brand">tempi di consegna</a> non
          dipendono dalla versione software. Modelli:{' '}
          <a href={ROUTES.model3} class="text-brand">Model 3</a> ·{' '}
          <a href={ROUTES.modelY} class="text-brand">Model Y</a>.
        </p>
      </section>

      <section class="mt-16">
        <h2 class="heading-28 m-0">Domande frequenti sul software Tesla</h2>
        <div class="mt-6">
          <Faq items={pageFaq} />
        </div>
      </section>

      <div class="mt-16">
        <CtaBanner title="Il software non sostituisce il referral" />
      </div>
    </div>
  </article>
</BaseLayout>
