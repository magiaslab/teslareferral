---
import { CONTACT_MAILTO, REFERRAL_URL } from '../consts';
import Button from './Button.astro';

interface Props {
  title?: string;
  summary?: string;
  primaryLabel?: string;
  secondaryLabel?: string;
}

const {
  title = 'Vuoi i 1.000 km Supercharger?',
  summary = "Apri il link prima di configurare l'auto. Dopo l'ordine Tesla non lo associa più.",
  primaryLabel = 'Ottieni i 1.000 km',
  secondaryLabel = 'Hai dubbi? Scrivimi',
} = Astro.props;
---

<section class="rounded-[14px] bg-[#14151A] px-7 py-12 md:px-12 md:py-16 text-[#F2F2F0]">
  <h2 class="heading-28 m-0 text-[#F2F2F0]">{title}</h2>
  <p class="body-18 m-0 mt-4 max-w-[40rem] text-[#9BA0AB]">{summary}</p>
  <div class="mt-8 flex flex-col sm:flex-row gap-4">
    <Button variant="primary" href={REFERRAL_URL} external onDark icon="arrow-right">
      {primaryLabel}
    </Button>
    <Button variant="on-dark" href={CONTACT_MAILTO} icon="mail">
      {secondaryLabel}
    </Button>
  </div>
</section>
