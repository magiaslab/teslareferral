---
import { BRAND, isActivePath, MORE_LINKS, NAV_LINKS, REFERRAL_URL } from '../consts';
import Button from './Button.astro';
import Icon from './Icon.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const menuLinks = [...NAV_LINKS, ...MORE_LINKS];
---

<header class="sticky top-0 z-50 border-b border-line bg-paper">
  <nav class="wrap flex h-16 items-center gap-3" aria-label="Principale">
    <a href="/" class="flex items-center gap-2.5 no-underline text-ink shrink-0 min-h-11">
      <span
        class="flex h-[30px] w-[30px] items-center justify-center rounded-[6px] bg-[#0E7C66] font-display text-[18px] font-bold leading-none text-white"
        aria-hidden="true"
      >
        C
      </span>
      <span class="font-display text-lg font-bold tracking-tight max-[420px]:hidden">{BRAND}</span>
    </a>

    <ul class="hidden lg:flex items-center justify-center gap-0.5 xl:gap-1 list-none m-0 p-0 flex-1 min-w-0">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'inline-flex items-center min-h-11 px-2 xl:px-2.5 text-[13px] xl:text-sm font-medium no-underline whitespace-nowrap hover:text-brand',
                isActivePath(path, link) ? 'text-brand' : 'text-ink',
              ]}
              aria-current={isActivePath(path, link) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="ml-auto flex items-center gap-1.5 lg:ml-0 shrink-0">
      <button
        type="button"
        id="theme-toggle"
        class="inline-flex h-11 w-11 items-center justify-center rounded-[10px] text-ink hover:bg-brand-tint"
        aria-label="Attiva il tema scuro"
        aria-pressed="false"
      >
        <span class="dark:hidden"><Icon name="moon" size={20} /></span>
        <span class="hidden dark:block"><Icon name="sun" size={20} /></span>
      </button>

      <details class="nav-menu relative lg:hidden">
        <summary aria-label="Apri il menu">
          <Icon name="menu" size={20} />
          <span class="sr-only">Menu</span>
        </summary>
        <ul class="absolute right-0 mt-2 w-60 list-none m-0 p-3 rounded-[14px] border border-line bg-surface shadow-md">
          {
            menuLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    'flex items-center min-h-11 px-2 rounded-[8px] text-sm no-underline hover:bg-brand-tint',
                    isActivePath(path, link) ? 'text-brand font-semibold' : 'text-ink',
                  ]}
                  aria-current={isActivePath(path, link) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>

      <Button href={REFERRAL_URL} external icon="arrow-right" class="!px-3 !text-sm xl:!px-5 whitespace-nowrap">
        Ottieni i 1.000 km
      </Button>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    function sync() {
      var dark = document.documentElement.classList.contains('dark');
      btn.setAttribute('aria-label', dark ? 'Attiva il tema chiaro' : 'Attiva il tema scuro');
      btn.setAttribute('aria-pressed', dark ? 'true' : 'false');
    }
    sync();
    btn.addEventListener('click', function () {
      var dark = !document.documentElement.classList.contains('dark');
      document.documentElement.classList.toggle('dark', dark);
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch (e) {}
      sync();
    });
  })();
</script>
