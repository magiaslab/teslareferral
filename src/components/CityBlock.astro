---
import { render, type CollectionEntry } from 'astro:content';
import { REFERRAL_URL } from '../consts';

interface Props {
  entry: CollectionEntry<'cities'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const isH2 = entry.data.headingLevel === 'h2';
---

<section id={entry.data.slug} class={isH2 ? 'mt-16' : 'mt-10'}>
  {
    isH2 ? (
      <h2 class="heading-28 m-0">{entry.data.heading}</h2>
    ) : (
      <h3 class="heading-22 m-0">{entry.data.heading}</h3>
    )
  }
  <div class="content-md body-18 mt-4">
    <Content />
  </div>
  <p class="caption-14 text-ink-soft m-0 mt-4">{entry.data.pickupNote}</p>
  <p class="body-16 m-0 mt-3">
    <a
      href={REFERRAL_URL}
      target="_blank"
      rel="nofollow noopener"
      class="text-brand font-semibold"
      data-referral-cta
      data-cta-position={`city-${entry.data.slug}`}
    >
      Guarda le Tesla in pronta consegna con il codice già applicato
    </a>
  </p>
</section>
