---
import { OCTOPUS_REFERRAL_URL, REFERRAL_URL } from '../consts';
import { trackEventForHref } from '../lib/analytics';
import type { IconName } from '../types';
import Icon from './Icon.astro';

interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'on-dark';
  href: string;
  external?: boolean;
  disabled?: boolean;
  hero?: boolean;
  onDark?: boolean;
  class?: string;
  icon?: IconName;
  iconPosition?: 'start' | 'end';
}

const {
  variant = 'primary',
  href,
  external = false,
  disabled = false,
  hero = false,
  onDark = false,
  class: className = '',
  icon,
  iconPosition = icon === 'arrow-right' || icon === 'external-link' ? 'end' : 'start',
} = Astro.props;

const isReferral =
  href === REFERRAL_URL ||
  href === OCTOPUS_REFERRAL_URL ||
  href.startsWith('https://ts.la/') ||
  href.includes('/octo-friends/');
const rel = external ? (isReferral ? 'nofollow noopener' : 'noopener') : undefined;
const target = external ? '_blank' : undefined;

const variantClass = disabled
  ? 'btn-disabled'
  : variant === 'secondary'
    ? 'btn-secondary'
    : variant === 'ghost'
      ? 'btn-ghost'
      : variant === 'on-dark'
        ? 'btn-on-dark'
        : onDark
          ? 'btn-primary-on-dark'
          : 'btn-primary';

const classes = ['btn', variantClass, hero && 'btn-hero', className];
const trackEvent = trackEventForHref(href);
---

{
  disabled ? (
    <span class:list={classes} aria-disabled="true">
      {icon && iconPosition === 'start' && <Icon name={icon} size={18} />}
      <slot />
      {icon && iconPosition === 'end' && <Icon name={icon} size={18} />}
    </span>
  ) : (
    <a class:list={classes} href={href} target={target} rel={rel} data-track-event={trackEvent}>
      {icon && iconPosition === 'start' && <Icon name={icon} size={18} />}
      <slot />
      {icon && iconPosition === 'end' && <Icon name={icon} size={18} />}
    </a>
  )
}
