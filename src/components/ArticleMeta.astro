---
import { MAGIASLAB_URL, OWNER_NAME, OWNER_ORG, VERIFIED_DATE, formatVerifiedDateIt } from '../consts';

interface Props {
  reading?: string;
}

const { reading } = Astro.props;
const verified = formatVerifiedDateIt(VERIFIED_DATE);
---

<p class="caption-14 text-ink-soft m-0">
  {reading && <>{reading} · </>}
  Aggiornata ad {verified} · Autore: {OWNER_NAME} —{' '}
  <a href={MAGIASLAB_URL} class="text-brand no-underline hover:underline" target="_blank" rel="noopener">
    {OWNER_ORG}
  </a>
  {' '}(proprietario Model Y verificato)
</p>
