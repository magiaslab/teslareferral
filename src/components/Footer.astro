---
import {
  BRAND,
  CONTACT_EMAIL,
  CONTACT_MAILTO,
  DOMAIN,
  FOOTER_GROUPS,
  MAGIASLAB_URL,
  OWNER_ORG,
  ROUTES,
} from '../consts';
import Disclaimer from './Disclaimer.astro';
import FreshnessBadge from './FreshnessBadge.astro';
import Icon from './Icon.astro';
---

<footer class="border-t border-line bg-paper">
  <div class="wrap py-12 md:py-16">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div>
        <a href="/" class="flex items-center gap-3 no-underline text-ink min-h-11">
          <span
            class="flex h-[30px] w-[30px] items-center justify-center rounded-[6px] bg-[#0E7C66] font-display text-[18px] font-bold leading-none text-white"
            aria-hidden="true"
          >
            C
          </span>
          <span class="font-display text-lg font-bold tracking-tight">{BRAND}</span>
        </a>
        <p class="body-16 text-ink-soft m-0 mt-4">
          {DOMAIN} — a cura di Alessandro Cipriani,{' '}
          <a href={MAGIASLAB_URL} target="_blank" rel="noopener" class="text-brand no-underline hover:underline">
            {OWNER_ORG}
          </a>
        </p>
        <div class="mt-3">
          <FreshnessBadge />
        </div>
      </div>

      {
        FOOTER_GROUPS.map((group) => (
          <div>
            <p class="caption-14 font-semibold m-0 mb-2">{group.title}</p>
            <ul class="flex flex-col list-none m-0 p-0">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="inline-flex items-center min-h-10 caption-14 text-ink no-underline hover:text-brand"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div>
        <p class="caption-14 font-semibold m-0 mb-2">Contatti e note</p>
        <ul class="flex flex-col list-none m-0 p-0">
          <li>
            <a
              href={CONTACT_MAILTO}
              class="inline-flex items-center gap-2 min-h-10 caption-14 text-ink no-underline hover:text-brand"
            >
              <Icon name="mail" size={16} />
              {CONTACT_EMAIL}
            </a>
          </li>
          <li>
            <a
              href={MAGIASLAB_URL}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 min-h-10 caption-14 text-ink no-underline hover:text-brand"
            >
              <Icon name="globe" size={16} />
              www.magiaslab.com
            </a>
          </li>
          <li>
            <a href={ROUTES.privacy} class="inline-flex items-center min-h-10 caption-14 text-ink no-underline hover:text-brand">
              Privacy policy
            </a>
          </li>
          <li>
            <a href={ROUTES.cookie} class="inline-flex items-center min-h-10 caption-14 text-ink no-underline hover:text-brand">
              Cookie policy
            </a>
          </li>
          <li>
            <button
              type="button"
              data-cookie-prefs
              class="inline-flex items-center gap-2 min-h-10 caption-14 text-ink bg-transparent border-0 p-0 cursor-pointer hover:text-brand"
            >
              <Icon name="settings" size={16} />
              Preferenze cookie
            </button>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-8 border-t border-line">
      <Disclaimer />
    </div>
  </div>
</footer>
