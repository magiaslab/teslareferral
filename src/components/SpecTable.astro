---
interface Row {
  label: string;
  value: string;
}

interface Props {
  caption: string;
  headers: [string, string];
  rows: Row[];
  note?: string;
}

const { caption, headers, rows, note } = Astro.props;
---

<div class="overflow-hidden rounded-[14px] border border-line">
  <table class="w-full border-collapse text-left">
    <caption class="sr-only">{caption}</caption>
    <thead class="bg-[#F3F3F0] dark:bg-[#252830]">
      <tr>
        <th scope="col" class="body-16 font-semibold px-6 py-4 border-b border-line">{headers[0]}</th>
        <th scope="col" class="body-16 font-semibold px-6 py-4 border-b border-line">{headers[1]}</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row, index) => (
          <tr class={index % 2 === 0 ? 'bg-[#FAFAF8] dark:bg-paper' : 'bg-surface'}>
            <th scope="row" class="body-16 font-semibold px-6 py-4 border-b border-line">
              {row.label}
            </th>
            <td class="body-16 px-6 py-4 border-b border-line">{row.value}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
{note && <p class="caption-14 text-ink-soft m-0 mt-4">{note}</p>}
