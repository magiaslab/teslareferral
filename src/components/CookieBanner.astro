---
import { COOKIE_CONSENT_KEY, COOKIE_CONSENT_MAX_DAYS, GA_MEASUREMENT_ID, ROUTES } from '../consts';
import Icon from './Icon.astro';
---

<div
  id="cookie-banner"
  hidden
  role="region"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-desc"
  class="fixed inset-x-0 bottom-0 z-[60] border-t border-line bg-surface shadow-lg"
>
  <div class="wrap py-3.5 md:py-4">
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
      <div class="flex gap-3 min-w-0">
        <Icon name="cookie" size={22} class="mt-0.5 text-brand" />
        <div>
          <p id="cookie-title" class="m-0 text-base font-semibold">Cookie e misurazione</p>
          <p id="cookie-desc" class="caption-14 text-ink-soft m-0 mt-2 max-w-[48rem]">
            Se accetti usiamo Google Analytics 4 per capire quali pagine e pulsanti servono.
            Niente pubblicità. Dettagli nella{' '}
            <a href={ROUTES.cookie} class="text-brand">cookie policy</a>.
          </p>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 shrink-0">
        <button type="button" class="btn btn-secondary" data-cookie-reject>Rifiuta</button>
        <button type="button" class="btn btn-primary" data-cookie-accept>Accetta</button>
      </div>
    </div>
  </div>
</div>

<script
  is:inline
  define:vars={{
    measurementId: GA_MEASUREMENT_ID,
    consentKey: COOKIE_CONSENT_KEY,
    maxDays: COOKIE_CONSENT_MAX_DAYS,
  }}
>
  (function () {
    var banner = document.getElementById('cookie-banner');
    var loaded = false;

    function getCookie(name) {
      var parts = ('; ' + document.cookie).split('; ' + name + '=');
      if (parts.length < 2) return null;
      return decodeURIComponent(parts.pop().split(';').shift() || '');
    }

    function setCookie(name, value, days) {
      var cookie =
        name +
        '=' +
        encodeURIComponent(value) +
        '; Path=/; Max-Age=' +
        days * 24 * 60 * 60 +
        '; SameSite=Lax';
      if (location.protocol === 'https:') cookie += '; Secure';
      document.cookie = cookie;
    }

    function choice() {
      var fromCookie = getCookie(consentKey);
      if (fromCookie === 'accepted' || fromCookie === 'rejected') return fromCookie;
      try {
        var legacy = localStorage.getItem(consentKey);
        if (legacy === 'accepted' || legacy === 'rejected') {
          setCookie(consentKey, legacy, maxDays);
          localStorage.removeItem(consentKey);
          return legacy;
        }
      } catch (e) {}
      return null;
    }

    function hideBanner() {
      if (banner) banner.hidden = true;
    }

    function showBanner() {
      if (!banner) return;
      banner.hidden = false;
      var focusTarget = banner.querySelector('[data-cookie-accept]');
      if (focusTarget instanceof HTMLElement && document.activeElement && document.activeElement.closest('[data-cookie-prefs]')) {
        focusTarget.focus();
      }
    }

    function loadGtag() {
      if (loaded || !measurementId) return;
      loaded = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag =
        window.gtag ||
        function () {
          window.dataLayer.push(arguments);
        };
      window.gtag('consent', 'update', {
        analytics_storage: 'granted',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      });
      var script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=' + measurementId;
      script.onload = function () {
        window.gtag('js', new Date());
        window.gtag('config', measurementId, {
          anonymize_ip: true,
          allow_google_signals: false,
          allow_ad_personalization_signals: false,
        });
      };
      document.head.appendChild(script);
    }

    function setConsent(value) {
      setCookie(consentKey, value, maxDays);
      hideBanner();
      if (value === 'accepted') {
        loadGtag();
        return;
      }
      if (typeof window.gtag === 'function') {
        window.gtag('consent', 'update', {
          analytics_storage: 'denied',
          ad_storage: 'denied',
        });
      }
    }

    function trackCta(el) {
      if (choice() !== 'accepted' || typeof window.gtag !== 'function') return;
      var eventName = el.getAttribute('data-track-event') || 'cta_click';
      var label = (el.textContent || '').replace(/\s+/g, ' ').trim();
      window.gtag('event', eventName, {
        event_category: 'conversion',
        event_label: label,
        link_url: el.getAttribute('href') || '',
        transport_type: 'beacon',
      });
    }

    document.addEventListener('click', function (event) {
      var target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('[data-cookie-accept]')) {
        setConsent('accepted');
        return;
      }
      if (target.closest('[data-cookie-reject]')) {
        setConsent('rejected');
        return;
      }
      if (target.closest('[data-cookie-prefs]')) {
        event.preventDefault();
        showBanner();
        return;
      }
      var cta = target.closest('[data-track-event]');
      if (cta) trackCta(cta);
    });

    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape' || !banner || banner.hidden) return;
      var stored = choice();
      if (stored) hideBanner();
    });

    var stored = choice();
    if (stored === 'accepted') {
      hideBanner();
      loadGtag();
    } else if (stored === 'rejected') {
      hideBanner();
    } else {
      showBanner();
    }
  })();
</script>
