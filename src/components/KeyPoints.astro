---
interface Props {
  title?: string;
  items: string[];
}

const { title = 'Punti chiave', items } = Astro.props;
---

<aside class="rounded-[14px] border border-line bg-surface p-7 shadow-sm">
  <h2 class="heading-22 m-0">{title}</h2>
  <ul class="body-16 m-0 mt-4 pl-6 grid gap-3">
    {items.map((item) => <li>{item}</li>)}
  </ul>
</aside>
