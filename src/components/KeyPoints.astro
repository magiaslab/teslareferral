---
import Icon from './Icon.astro';

interface Props {
  title?: string;
  items: string[];
}

const { title = 'Cosa tenere a mente', items } = Astro.props;
---

<aside class="rounded-[14px] border border-line bg-surface p-7 shadow-sm">
  <h2 class="heading-22 m-0">{title}</h2>
  <ul class="body-16 m-0 mt-4 p-0 list-none grid gap-3">
    {
      items.map((item) => (
        <li class="flex items-start gap-3">
          <Icon name="check" size={18} class="mt-0.5 text-brand" />
          <span>{item}</span>
        </li>
      ))
    }
  </ul>
</aside>
