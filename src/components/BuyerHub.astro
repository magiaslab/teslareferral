---
import { ROUTES } from '../consts';

const cards = [
  { href: ROUTES.delivery, kicker: 'Stock', title: 'Pronta consegna', text: 'Come averla subito, città e modelli.' },
  { href: ROUTES.deliveryTimes, kicker: 'Attesa', title: 'Tempi di consegna', text: 'Quanto si aspetta se configuri da zero.' },
  { href: ROUTES.prices, kicker: 'Listino', title: 'Prezzi e incentivi', text: 'Model 3, Model Y e cumulo col referral.' },
  { href: ROUTES.modelY, kicker: 'SUV', title: 'Model Y', text: 'Versioni, autonomia, Standard e 7 posti.' },
  { href: ROUTES.model3, kicker: 'Berlina', title: 'Model 3', text: 'Highland, autonomia, novità 2026.' },
] as const;
---

<section class="rounded-[14px] border border-line bg-surface p-7 md:p-8">
  <h2 class="heading-22 m-0">Stai per comprare? Parti da qui</h2>
  <p class="body-16 text-ink-soft m-0 mt-3">
    Guide su ritiro, listino e modelli. Il referral si applica dopo, sullo stesso prezzo, prima di ordinare.
  </p>
  <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3 list-none m-0 p-0">
    {
      cards.map((card) => (
        <li>
          <a
            href={card.href}
            class="block rounded-[12px] border border-line bg-paper p-5 no-underline text-ink hover:border-brand"
          >
            <p class="caption-14 text-ink-soft m-0">{card.kicker}</p>
            <p class="heading-22 m-0 mt-1 text-[1.05rem]">{card.title}</p>
            <p class="body-16 text-ink-soft m-0 mt-2">{card.text}</p>
          </a>
        </li>
      ))
    }
  </ul>
</section>
